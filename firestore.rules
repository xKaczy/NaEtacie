rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper: Check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper: Check if announcement is older than 48 hours
    function isOlderThan48Hours(resourceData) {
      return resourceData.scraped_at < request.time - duration.value(48, 'h');
    }

    // Helper: Check if authenticated user is premium tier
    function isPremiumUser() {
      return isAuthenticated() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.tier == 'premium';
    }

    // Announcements collection
    match /announcements/{announcementId} {
      // Admin SDK (Cloud Functions, API routes) can write — client cannot
      allow create, update, delete: if false;

      // Unauthenticated & free users can only read announcements older than 48 hours;
      // Premium users can read all announcements.
      allow read: if isPremiumUser() || isOlderThan48Hours(resource.data);
    }

    // Users collection
    match /users/{userId} {
      // Users can read their own profile
      allow read: if isAuthenticated() && request.auth.uid == userId;

      // Users can create their own profile (first login)
      allow create: if isAuthenticated() && request.auth.uid == userId;

      // Users can update their own profile, but cannot modify sensitive fields (uid, email, tier, created_at)
      allow update: if isAuthenticated() &&
        request.auth.uid == userId &&
        request.resource.data.uid == resource.data.uid &&
        request.resource.data.email == resource.data.email &&
        request.resource.data.tier == resource.data.tier &&
        request.resource.data.created_at == resource.data.created_at;

      allow delete: if false;
    }

    // Geo cache collection - only accessible by Cloud Functions (admin SDK)
    match /geo_cache/{cacheId} {
      allow read, write: if false;
    }
  }
}

